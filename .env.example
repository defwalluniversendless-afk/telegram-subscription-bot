# Telegram bot token from @BotFather
BOT_TOKEN=

# Closed channel ID (for example, -1001234567890) and administrator Telegram ID
CHANNEL_ID=
ADMIN_ID=

# Set to 1 only to simulate payments locally without YooKassa.
# For YooKassa test payments, set to 0 and use the test shop credentials below.
TEST_MODE=0

# YooKassa shop ID and secret key (use test credentials for test payments)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=

PRICE=990
PERIOD_DAYS=30
REMIND_DAYS=3
AUTOCHARGE=0
WEBHOOK_PORT=0
RETURN_URL=https://t.me/
