# Telegram bot token from @BotFather
BOT_TOKEN=

# Closed channel ID (for example, -1001234567890) and administrator Telegram ID
CHANNEL_ID=
ADMIN_ID=

# Set to 1 only to simulate payments locally without YooKassa.
# For YooKassa test payments, set to 0 and use the test shop credentials below.
TEST_MODE=0

# The admin /menu store switch uses these separate credentials:
YOOKASSA_TEST_SHOP_ID=
YOOKASSA_TEST_SECRET=
YOOKASSA_LIVE_SHOP_ID=
YOOKASSA_LIVE_SECRET=

# Initial store selection. Runtime selection is saved in bot.db.
PAYMENT_STORE_MODE=test

# Legacy single-store credentials. Used only when mode matches PAYMENT_STORE_MODE.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=

PRICE=2500
PERIOD_DAYS=30
REMIND_DAYS=3
AUTOCHARGE=0
WEBHOOK_PORT=0
RETURN_URL=https://t.me/
